# Copy to .env.local and fill in. Without these the site falls back to a
# browser-local demo roster (see lib/students.ts), which is enough to click
# through /admin but stores nothing on a server.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role.
# Server-only: it bypasses row-level security, so never prefix it with
# NEXT_PUBLIC_ and never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed for the .pptx → PDF conversion in /api/convert-slides
CLOUDCONVERT_API_KEY=

# Copy to .env.local and fill in. Without these the site falls back to
# browser-local storage — a seeded demo roster (lib/students.ts) and edits that
# stay in the browser that made them (lib/site-content.ts). Enough to click
# through /admin and the editors, but nothing is stored on a server or shared.

# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → service_role.
# Server-only: it bypasses row-level security, so never prefix it with
# NEXT_PUBLIC_ and never reference it from a client component.
SUPABASE_SERVICE_ROLE_KEY=
